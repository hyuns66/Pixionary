<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">


    <Transition
        android:id="@+id/transition_document_home"
        motion:constraintSetEnd="@id/home_document"
        motion:constraintSetStart="@id/home_general">

        <OnSwipe
            motion:dragDirection="dragLeft"
            motion:touchAnchorSide="right"/>

        <KeyFrameSet>

            <KeyPosition
                motion:motionTarget="@id/extracting_progress_cv"
                motion:keyPositionType="deltaRelative"
                motion:framePosition="10"
                motion:percentY="-0.25"/>

            <KeyPosition
                motion:motionTarget="@id/extracting_progress_cv"
                motion:keyPositionType="deltaRelative"
                motion:framePosition="50"
                motion:percentY="1.0"/>

            <KeyPosition
                motion:motionTarget="@id/drawer"
                motion:framePosition="50"
                motion:percentHeight="0.0"/>

        </KeyFrameSet>

    </Transition>

    <Transition
        android:id="@+id/transition_general_home"
        motion:constraintSetEnd="@id/home_general"
        motion:constraintSetStart="@id/home_document">

        <OnSwipe
            motion:dragDirection="dragRight"
            motion:touchAnchorSide="left"/>

        <KeyFrameSet>

            <KeyPosition
                motion:motionTarget="@id/extracting_progress_cv"
                motion:keyPositionType="deltaRelative"
                motion:framePosition="50"
                motion:percentY="0.0"/>

            <KeyPosition
                motion:motionTarget="@id/drawer"
                motion:framePosition="50"
                motion:percentHeight="0.0"/>

        </KeyFrameSet>

    </Transition>

    <ConstraintSet android:id="@+id/home_general">

        <Constraint android:id="@+id/root_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintTop_toTopOf="parent"
            motion:layout_constraintBottom_toBottomOf="parent">
            <CustomAttribute
                motion:attributeName="backgroundColor"
                motion:customColorValue="@color/general_search_home_bg" />
        </Constraint>

        <Constraint
            android:id="@+id/general_search_bg"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginEnd="25dp"
            android:layout_marginStart="25dp"
            android:background="@drawable/search_background"
            android:layout_marginTop="20dp"
            motion:layout_constraintVertical_bias="0.4"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent"
            motion:layout_constraintBottom_toBottomOf="parent"/>

        <Constraint
            android:id="@+id/document_search_bg"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginEnd="25dp"
            android:layout_marginStart="25dp"
            android:background="@drawable/search_background"
            android:layout_marginTop="20dp"
            motion:layout_constraintVertical_bias="0.4"
            motion:layout_constraintStart_toEndOf="parent"
            motion:layout_constraintTop_toTopOf="parent"
            motion:layout_constraintBottom_toBottomOf="parent"/>

        <Constraint
            android:id="@+id/general_search_script_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            motion:layout_constraintVertical_bias="0.65"
            motion:layout_constraintTop_toTopOf="parent"
            motion:layout_constraintStart_toStartOf="@id/general_search_bg"
            motion:layout_constraintEnd_toEndOf="@id/general_search_bg"
            motion:layout_constraintBottom_toTopOf="@id/general_search_bg"/>

        <Constraint
            android:id="@+id/document_search_script_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            motion:layout_constraintVertical_bias="0.65"
            motion:layout_constraintTop_toTopOf="parent"
            motion:layout_constraintStart_toStartOf="@id/document_search_bg"
            motion:layout_constraintEnd_toEndOf="@id/document_search_bg"
            motion:layout_constraintBottom_toTopOf="@id/document_search_bg"/>

        <Constraint
            android:id="@+id/search_general_anim"
            android:layout_width="160dp"
            android:layout_height="160dp"
            motion:layout_constraintVertical_bias="0.35"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintTop_toBottomOf="@id/general_search_bg"
            motion:layout_constraintBottom_toBottomOf="parent"/>

        <Constraint
            android:id="@+id/search_document_anim"
            android:layout_width="160dp"
            android:layout_height="160dp"
            motion:layout_constraintVertical_bias="0.35"
            motion:layout_constraintStart_toEndOf="parent"
            motion:layout_constraintTop_toBottomOf="@id/document_search_bg"
            motion:layout_constraintBottom_toBottomOf="parent"/>

        <Constraint
            android:id="@+id/extracting_progress_cv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            android:layout_marginBottom="25dp"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintBottom_toBottomOf="parent"/>

        <Constraint
            android:id="@+id/drawer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#FFC107"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintBottom_toBottomOf="parent"/>


    </ConstraintSet>

    <ConstraintSet android:id="@+id/home_document">

        <Constraint android:id="@+id/root_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintTop_toTopOf="parent"
            motion:layout_constraintBottom_toBottomOf="parent">
            <CustomAttribute
                motion:attributeName="backgroundColor"
                motion:customColorValue="@color/black" />
        </Constraint>

        <Constraint
            android:id="@+id/general_search_bg"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginEnd="25dp"
            android:layout_marginStart="25dp"
            android:background="@drawable/search_background"
            android:layout_marginTop="20dp"
            motion:layout_constraintVertical_bias="0.4"
            motion:layout_constraintEnd_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent"
            motion:layout_constraintBottom_toBottomOf="parent"/>

        <Constraint
            android:id="@+id/document_search_bg"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginEnd="25dp"
            android:layout_marginStart="25dp"
            android:background="@drawable/search_background"
            android:layout_marginTop="20dp"
            motion:layout_constraintVertical_bias="0.4"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent"
            motion:layout_constraintBottom_toBottomOf="parent"/>

        <Constraint
            android:id="@+id/general_search_script_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            motion:layout_constraintVertical_bias="0.65"
            motion:layout_constraintTop_toTopOf="parent"
            motion:layout_constraintEnd_toEndOf="@id/general_search_bg"
            motion:layout_constraintStart_toStartOf="@id/general_search_bg"
            motion:layout_constraintBottom_toTopOf="@id/general_search_bg"/>

        <Constraint
            android:id="@+id/document_search_script_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            motion:layout_constraintVertical_bias="0.65"
            motion:layout_constraintTop_toTopOf="parent"
            motion:layout_constraintStart_toStartOf="@id/document_search_bg"
            motion:layout_constraintEnd_toEndOf="@id/document_search_bg"
            motion:layout_constraintBottom_toTopOf="@id/document_search_bg"/>

        <Constraint
            android:id="@+id/search_general_anim"
            android:layout_width="160dp"
            android:layout_height="160dp"
            motion:layout_constraintVertical_bias="0.35"
            motion:layout_constraintTop_toBottomOf="@id/general_search_bg"
            motion:layout_constraintEnd_toStartOf="parent"
            motion:layout_constraintBottom_toBottomOf="parent"/>

        <Constraint
            android:id="@+id/search_document_anim"
            android:layout_width="160dp"
            android:layout_height="160dp"
            motion:layout_constraintVertical_bias="0.35"
            motion:layout_constraintTop_toBottomOf="@id/general_search_bg"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintBottom_toBottomOf="parent"/>

        <Constraint
            android:id="@+id/extracting_progress_cv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            android:layout_marginBottom="25dp"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintTop_toBottomOf="parent"/>


        <Constraint
            android:id="@+id/drawer"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:background="#FFC107"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintBottom_toBottomOf="parent"/>

    </ConstraintSet>

</MotionScene>
